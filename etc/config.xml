<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <maatoo>
            <general>
                <active>0</active>
                <url></url>
                <user></user>
                <password></password>
                <cleanup_enabled>0</cleanup_enabled>
                <retention_days>180</retention_days>
                <safe_to_delete_stores></safe_to_delete_stores>
            </general>
            <order>
                <lifetime>365</lifetime>
            </order>
            <website>
                <website_active>0</website_active>
                <allowed_store>0</allowed_store>
                <opt_in>0</opt_in>
                <opt_in_text>I want to receive emails with special offers</opt_in_text>
            </website>
            <newsletter>
                <disable_newsletter_email>1</disable_newsletter_email>
            </newsletter>
            <scheduling>
                <stores_import_cron_schedule>*/5 * * * *</stores_import_cron_schedule>
                <categories_import_cron_schedule>0 */8 * * *</categories_import_cron_schedule>
                <products_import_cron_schedule>*/5 * * * *</products_import_cron_schedule>
                <orders_import_cron_schedule>*/5 * * * *</orders_import_cron_schedule>
                <all_orders_import_cron_schedule>*/10 * * * *</all_orders_import_cron_schedule>
                <order_lines_import_cron_schedule>*/10 * * * *</order_lines_import_cron_schedule>
                <all_order_lines_import_cron_schedule>*/15 * * * *</all_order_lines_import_cron_schedule>
            </scheduling>
        </maatoo>
        <csp>
            <policies>
                <storefront>
                    <frame-ancestors>
                        <inline>0</inline>
                    </frame-ancestors>
                </storefront>
                <admin>
                    <frame-ancestors>
                        <inline>0</inline>
                    </frame-ancestors>
                </admin>
            </policies>
        </csp>
    </default>
</config>
